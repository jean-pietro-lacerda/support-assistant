CHAVE_API_LLM="SUA_CHAVE_DE_API_AQUI"
GROQ_MODEL="COLOQUE_AQUI_O_MODELO_DESEJADO"
# na aplicação utilizei o modelo openai/gpt-oss-120b, mas você pode escolher outro modelo disponível no Groq Studio.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seu_banco_de_dados
DB_USER=seu_usuario
DB_PASSWORD=SUA_SENHA
# Docker Compose usa DB_NAME, DB_USER e DB_PASSWORD acima para criar o banco.
# No Docker, DB_HOST e DB_PORT são definidos como db:5432 pelo compose.yaml.
# Na execução local, mantenha o endereço e a porta do seu PostgreSQL.
# O proxy local do Vite continua usando http://localhost:8001 por padrão.
# API_PROXY_TARGET pode ser definida no ambiente para substituir esse destino.
